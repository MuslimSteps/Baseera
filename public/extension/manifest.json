{
  "manifest_version": 3,
  "name": "بصيرة — Baseera: التحقق الفوري للمحتوى الإسلامي",
  "version": "1.2.0",
  "description": "طبقة تحقق فورية وسياقية للقرآن الكريم، الحديث النبوي، المصطلحات الشرعية، والمسائل الفقهية أثناء تصفح الويب للمعرّفين والباحثين",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": ["https://baseera.onrender.com/*", "http://localhost:3000/*", "*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.svg"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "بصيرة — التحقق الفوري للمحتوى الإسلامي",
    "default_icon": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
