# Groq server-side API key. Never commit a real key here.
# Configure GROQ_API_KEY in your deployment/server secret manager.
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# Optional: override the text model. Defaults to the strongest FREE Groq model
# available for a key (openai/gpt-oss-120b). Any model id from
# https://api.groq.com/openai/v1/models can be used.
GROQ_TEXT_MODEL="openai/gpt-oss-120b"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Approved Islamic Content MCP server (read-only source retrieval).
# Endpoint: https://mcp.islamiccontent.org/mcp
ISLAMIC_CONTENT_MCP_URL="https://mcp.islamiccontent.org/mcp"
